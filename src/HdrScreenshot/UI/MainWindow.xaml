<Window x:Class="HdrScreenshot.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="HDR Screenshot" Width="1320" Height="900" MinWidth="1080" MinHeight="760"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource Bg}" Foreground="{StaticResource Text}"
        FontFamily="{StaticResource UiFont}" UseLayoutRounding="True" SnapsToDevicePixels="True"
        Icon="/icon.ico">

    <Grid Margin="30,20,30,26">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
            <Image x:Name="LogoImage" Width="46" Height="46" RenderOptions.BitmapScalingMode="NearestNeighbor" VerticalAlignment="Center"/>
            <StackPanel Margin="16,0,0,0" VerticalAlignment="Center">
                <TextBlock Text="HDR Screenshot" Style="{StaticResource Title}"/>
                <TextBlock Text="Capture any screen, app or region in true HDR, or tone-map it to clean SDR." Style="{StaticResource Subtitle}" Margin="0,2,0,0"/>
            </StackPanel>
        </StackPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="400"/>
                <ColumnDefinition Width="22"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- ============================== Left: source -->
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Border Style="{StaticResource CardBorder}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Text="Source" Style="{StaticResource Section}"/>

                        <UniformGrid Grid.Row="1" Rows="1" Margin="0,14,0,12">
                            <RadioButton x:Name="ModeScreen" GroupName="mode" Style="{StaticResource Seg}" Content="Screen" Checked="Mode_Checked"/>
                            <RadioButton x:Name="ModeApp" GroupName="mode" Style="{StaticResource Seg}" Content="App" Checked="Mode_Checked"/>
                            <RadioButton x:Name="ModeRegion" GroupName="mode" Style="{StaticResource Seg}" Content="Region" Checked="Mode_Checked"/>
                        </UniformGrid>

                        <!-- Screen list -->
                        <Grid Grid.Row="2" x:Name="ScreenPanel">
                            <ListBox x:Name="MonitorList" Style="{StaticResource SourceList}" MouseDoubleClick="List_DoubleClick">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="34"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Path Data="M1,1 H25 V17 H1Z M8,21 H18 M13,17 V21" Stroke="{StaticResource Accent}" StrokeThickness="1.6"
                                                  VerticalAlignment="Center" HorizontalAlignment="Left"/>
                                            <StackPanel Grid.Column="1">
                                                <TextBlock Text="{Binding FriendlyName}" FontSize="13.5" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Text="{Binding Summary}" FontSize="12" Foreground="{StaticResource Muted}" Margin="0,2,0,0"/>
                                            </StackPanel>
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Grid>

                        <!-- App / window list -->
                        <Grid Grid.Row="2" x:Name="AppPanel" Visibility="Collapsed">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="SearchBox" TextChanged="SearchBox_TextChanged"/>
                                <TextBlock x:Name="SearchPlaceholder" Text="Search apps and windows" IsHitTestVisible="False"
                                           Foreground="{StaticResource Faint}" FontSize="13" Margin="11,0,0,0" VerticalAlignment="Center"/>
                                <Button Grid.Column="1" Style="{StaticResource FlatButton}" Content="Refresh" Margin="8,0,0,0" Padding="14,7" Click="Refresh_Click"/>
                            </Grid>
                            <ListBox Grid.Row="1" x:Name="WindowListBox" Style="{StaticResource SourceList}" MouseDoubleClick="List_DoubleClick">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="36"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Grid Width="26" Height="26" HorizontalAlignment="Left" VerticalAlignment="Center">
                                                <Border Background="{StaticResource AccentSoft}">
                                                    <TextBlock Text="{Binding Initial}" FontWeight="Bold" Foreground="{StaticResource AccentHover}"
                                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                <Border Background="{StaticResource Field}">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Icon}" Value="{x:Null}">
                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <Image Source="{Binding Icon}" RenderOptions.BitmapScalingMode="HighQuality"/>
                                                </Border>
                                            </Grid>
                                            <StackPanel Grid.Column="1">
                                                <TextBlock Text="{Binding Title}" FontSize="13.5" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Text="{Binding AppName}" FontSize="12" Foreground="{StaticResource Muted}" Margin="0,1,0,0" TextTrimming="CharacterEllipsis"/>
                                            </StackPanel>
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Grid>

                        <!-- Region explainer -->
                        <Border Grid.Row="2" x:Name="RegionPanel" Visibility="Collapsed" Background="{StaticResource Field}"
                                BorderBrush="{StaticResource Line}" BorderThickness="1">
                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="26">
                                <Grid Width="96" Height="66" HorizontalAlignment="Center">
                                    <Rectangle Stroke="{StaticResource Faint}" StrokeThickness="1.5" StrokeDashArray="3 3"/>
                                    <Rectangle Margin="22,14,14,10" Fill="{StaticResource AccentSoft}" Stroke="{StaticResource Accent}" StrokeThickness="2"/>
                                    <Path Data="M0,0 L0,15 L4,11 L7,18 L9.5,17 L6.5,10 L12,10 Z" Fill="White" Margin="70,44,0,0"/>
                                </Grid>
                                <TextBlock Text="Drag a box on any screen" FontSize="15" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,18,0,6"/>
                                <TextBlock TextAlignment="Center" FontSize="12.5" Foreground="{StaticResource Muted}" TextWrapping="Wrap" LineHeight="20">
                                    The screen freezes so nothing moves while you aim.<LineBreak/>
                                    Click a window to snap to it  ·  Enter = whole screen<LineBreak/>
                                    Esc or right-click cancels.
                                </TextBlock>
                            </StackPanel>
                        </Border>

                        <StackPanel Grid.Row="3">
                            <TextBlock Text="Delay" Style="{StaticResource FieldLabel}"/>
                            <UniformGrid Rows="1">
                                <RadioButton x:Name="Delay0" GroupName="delay" Style="{StaticResource Seg}" Content="None" Tag="0" Checked="Delay_Checked"/>
                                <RadioButton x:Name="Delay3" GroupName="delay" Style="{StaticResource Seg}" Content="3 s" Tag="3" Checked="Delay_Checked"/>
                                <RadioButton x:Name="Delay5" GroupName="delay" Style="{StaticResource Seg}" Content="5 s" Tag="5" Checked="Delay_Checked"/>
                                <RadioButton x:Name="Delay10" GroupName="delay" Style="{StaticResource Seg}" Content="10 s" Tag="10" Checked="Delay_Checked"/>
                            </UniformGrid>
                            <CheckBox x:Name="CursorCheck" Content="Include mouse cursor" Margin="0,16,0,0" Click="Option_Click"/>
                            <CheckBox x:Name="HideCheck" Content="Hide this window while capturing" Click="Option_Click"/>
                        </StackPanel>

                        <Button Grid.Row="4" x:Name="CaptureButton" Style="{StaticResource AccentButton}" Content="Capture" Margin="0,20,0,0" Click="Capture_Click"/>

                        <TextBlock Grid.Row="5" x:Name="HotkeyHint" Style="{StaticResource Hint}" Margin="0,10,0,0"/>
                    </Grid>
                </Border>

                <WrapPanel Grid.Row="1" x:Name="DisplayStatus" Margin="4,12,0,0"/>
            </Grid>

            <!-- ============================== Right: preview + output -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="16"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Border Style="{StaticResource CardBorder}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <Grid>
                            <TextBlock Text="Preview" Style="{StaticResource Section}" VerticalAlignment="Center"/>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <ToggleButton x:Name="ZebraToggle" Style="{StaticResource ToggleChip}" Content="Show HDR areas"
                                              ToolTip="Stripe everything brighter than SDR white" Click="Zebra_Click"/>
                                <UniformGrid Rows="1" Margin="14,0,0,0">
                                    <RadioButton x:Name="ZoomFit" GroupName="zoom" Style="{StaticResource SmallSeg}" Content="Fit" IsChecked="True" Checked="Zoom_Checked"/>
                                    <RadioButton x:Name="Zoom100" GroupName="zoom" Style="{StaticResource SmallSeg}" Content="100%" Checked="Zoom_Checked"/>
                                </UniformGrid>
                            </StackPanel>
                        </Grid>

                        <Grid Grid.Row="1" Margin="0,14,0,0" Background="{StaticResource Field}">
                            <Border Background="{StaticResource Checker}" x:Name="PreviewBackdrop" Visibility="Collapsed"/>
                            <ScrollViewer x:Name="PreviewScroll" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Disabled"
                                          PreviewMouseLeftButtonDown="Preview_MouseDown" PreviewMouseMove="Preview_MouseMove"
                                          PreviewMouseLeftButtonUp="Preview_MouseUp" Focusable="False">
                                <Image x:Name="PreviewImage" Stretch="Uniform" StretchDirection="DownOnly" Margin="12"
                                       RenderOptions.BitmapScalingMode="HighQuality"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </ScrollViewer>
                            <StackPanel x:Name="EmptyState" VerticalAlignment="Center" HorizontalAlignment="Center">
                                <Image x:Name="EmptyLogo" Width="64" Height="64" RenderOptions.BitmapScalingMode="NearestNeighbor" Opacity="0.55"/>
                                <TextBlock Text="Nothing captured yet" FontSize="16" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,16,0,6"/>
                                <TextBlock x:Name="EmptyHint" FontSize="12.5" Foreground="{StaticResource Muted}" HorizontalAlignment="Center" TextAlignment="Center"/>
                            </StackPanel>
                            <Border x:Name="BusyOverlay" Background="#B30c0e14" Visibility="Collapsed">
                                <TextBlock x:Name="BusyText" Text="Capturing…" FontSize="15" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </Grid>

                        <Grid Grid.Row="2" Margin="0,12,0,0">
                            <TextBlock x:Name="StatsText" FontSize="13" Foreground="{StaticResource Text}" TextTrimming="CharacterEllipsis" Margin="0,0,180,0"/>
                            <TextBlock x:Name="SourceText" FontSize="12.5" Foreground="{StaticResource Muted}" HorizontalAlignment="Right"
                                       TextTrimming="CharacterEllipsis" MaxWidth="320"/>
                        </Grid>
                    </Grid>
                </Border>

                <!-- Output -->
                <Border Grid.Row="2" Style="{StaticResource CardBorder}" Padding="22,6,22,20">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="28"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Tone mapping -->
                        <StackPanel>
                            <TextBlock Text="SDR tone mapping" Style="{StaticResource FieldLabel}"/>
                            <UniformGrid Rows="1">
                                <RadioButton x:Name="TmNatural" GroupName="tm" Style="{StaticResource Seg}" Content="Natural" Checked="ToneMap_Checked"/>
                                <RadioButton x:Name="TmFilmic" GroupName="tm" Style="{StaticResource Seg}" Content="Filmic" Checked="ToneMap_Checked"/>
                                <RadioButton x:Name="TmReinhard" GroupName="tm" Style="{StaticResource Seg}" Content="Reinhard" Checked="ToneMap_Checked"/>
                                <RadioButton x:Name="TmClip" GroupName="tm" Style="{StaticResource Seg}" Content="Clip" Checked="ToneMap_Checked"/>
                            </UniformGrid>
                            <Grid Margin="0,14,0,4">
                                <TextBlock Text="Exposure" FontSize="12.5" Foreground="{StaticResource Muted}"/>
                                <TextBlock x:Name="ExposureValue" Style="{StaticResource Value}" HorizontalAlignment="Right"/>
                            </Grid>
                            <Slider x:Name="ExposureSlider" Minimum="-3" Maximum="3" SmallChange="0.1" LargeChange="0.5"
                                    TickFrequency="0.1" IsSnapToTickEnabled="True" ValueChanged="Exposure_Changed"
                                    MouseDoubleClick="Exposure_Reset" ToolTip="Double-click to reset"/>
                            <TextBlock x:Name="ToneHint" Style="{StaticResource Hint}" MinHeight="34"/>
                        </StackPanel>

                        <!-- Format + destination -->
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Format" Style="{StaticResource FieldLabel}"/>
                            <UniformGrid Rows="1">
                                <RadioButton x:Name="FmtJxr" GroupName="fmt" Style="{StaticResource Seg}" Content="JXR" Checked="Format_Checked"/>
                                <RadioButton x:Name="FmtHdrPng" GroupName="fmt" Style="{StaticResource Seg}" Content="HDR PNG" Checked="Format_Checked"/>
                                <RadioButton x:Name="FmtPng" GroupName="fmt" Style="{StaticResource Seg}" Content="PNG" Checked="Format_Checked"/>
                                <RadioButton x:Name="FmtJpg" GroupName="fmt" Style="{StaticResource Seg}" Content="JPG" Checked="Format_Checked"/>
                                <RadioButton x:Name="FmtBoth" GroupName="fmt" Style="{StaticResource Seg}" Content="Both" Checked="Format_Checked"/>
                            </UniformGrid>
                            <TextBlock x:Name="FormatHint" Style="{StaticResource Hint}" MinHeight="34"/>
                            <Grid Margin="0,10,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="FolderBox" IsReadOnly="True"/>
                                <Button Grid.Column="1" Style="{StaticResource FlatButton}" Content="Browse" Margin="8,0,0,0" Click="Browse_Click"/>
                            </Grid>
                            <StackPanel Orientation="Horizontal">
                                <CheckBox x:Name="AutoSaveCheck" Content="Auto-save every capture" Click="Option_Click"/>
                                <CheckBox x:Name="ClipboardCheck" Content="Copy to clipboard" Margin="22,10,0,0" Click="Option_Click"/>
                            </StackPanel>
                        </StackPanel>

                        <Grid Grid.Row="1" Grid.ColumnSpan="3" Margin="0,18,0,0">
                            <TextBlock x:Name="SaveStatus" FontSize="12.5" Foreground="{StaticResource Faint}" VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis" Margin="0,0,420,0"/>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button x:Name="RevealButton" Style="{StaticResource LinkButton}" Content="Show in folder" VerticalAlignment="Center"
                                        Margin="0,0,22,0" Click="Reveal_Click"/>
                                <Button x:Name="CopyButton" Style="{StaticResource FlatButton}" Content="Copy" Padding="22,12" Click="Copy_Click"/>
                                <Button x:Name="SaveButton" Style="{StaticResource AccentButton}" Content="Save" Width="170" Margin="10,0,0,0" Click="Save_Click"/>
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</Window>
